// Example subc daemon config entry for the ai-provider-quota module.
//
// Install: merge this `modules` entry into your real subc config at
//   $XDG_CONFIG_HOME/cortexkit/subc.jsonc   (default: ~/.config/cortexkit/subc.jsonc)
// and point `program` at your built binary (cargo build --release →
// target/release/quota-module). On its next start, subc-core spawns + supervises it.
//
// The daemon appends `--subc <connection-file>` and injects the SUBC_MODULE_ID env
// var itself — do NOT add those to args/env here. The map KEY ("ai-provider-quota")
// is the module id the daemon registers it under.
{
  "version": 1,
  "modules": {
    "ai-provider-quota": {
      "program": "/abs/path/to/ai-provider-quota/target/release/quota-module",
      "args": [],
      "env": {},
      "enabled": true
    }
  }
}
